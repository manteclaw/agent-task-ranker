# Copy to .env or export in your shell / cron environment. All optional.
# Defaults are shown; uncomment and edit what you need.

# Platform-probe cache: JSON object keyed by platform name, each value
# an object with a "verdict" of GO / BLOCKED / UNKNOWN, as written by a
# pre-flight prober (see agent-preflight-probe). A missing file is fine —
# the ranker just scores without platform verdicts.
# (The --cache flag wins over this variable.)
# PLATFORM_PROBE_CACHE=$HOME/.state/platform-probe-cache.json
